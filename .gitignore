# Data - never commit real or sample data
data/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
env/
.venv/
*.ipynb_checkpoints/

# Environment / secrets
.env
*.env.local
secrets.yaml
config.local.yaml

# OS / editor
.DS_Store
.vscode/
.idea/

# Model artifacts (large binaries - track via releases/Domino, not git)
*.pkl
*.joblib
*.h5
models/*.bin
models/*.json

# CatBoost training logs (regenerated on every fit)
catboost_info/
src/catboost_info/

# Generated EDA figures (regenerated by notebooks)
reports/figures/

# Logs
*.log
*.tfevents
*.tb_logs
mlruns/

# Backup
backups/

# Electron (desktop app)
electron/node_modules/
electron/dist/
electron/dist_ok/
electron/release-*/
electron/out/

# PyInstaller build artifacts (regenerated by .\build-desktop.ps1)
build/
dist/
